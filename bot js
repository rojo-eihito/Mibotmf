const { default: makeWASocket, useMultiFileAuthState, DisconnectReason } = require('@whiskeysockets/baileys');
const axios = require('axios');

async function startBot() {
    const { state, saveCreds } = await useMultiFileAuthState('auth');
    const sock = makeWASocket({
        auth: state,
        printQRInTerminal: true
    });

    sock.ev.on('creds.update', saveCreds);

    sock.ev.on('messages.upsert', async ({ messages }) => {
        const m = messages[0];
        if (!m.message || m.key.fromMe) return;
        const text = m.message.conversation || m.message.extendedTextMessage?.text || '';
        const from = m.key.remoteJid;

        if (text.startsWith('.mf ') || text.includes('mediafire.com')) {
            let url = text.replace('.mf ', '').trim();
            await sock.sendMessage(from, { text: '⏳ Buscando tu archivo en Mediafire...' }, { quoted: m });
            try {
                // Aquí solo devuelve el link directo, no descarga pesado
                let api = `https://api.agungny.my.id/api/mediafire?url=${url}`;
                let res = await axios.get(api);
                let data = res.data.result;
                let msg = `✅ *MEDIAFIRE ENCONTRADO*\n\n📁 Nombre: ${data.filename}\n📦 Peso: ${data.size}\n\n🔗 Link directo:\n${data.link}`;
                await sock.sendMessage(from, { text: msg }, { quoted: m });
            } catch (e) {
                await sock.sendMessage(from, { text: '❌ No pude sacar el link, revisa que el link de Mediafire sirva.' }, { quoted: m });
            }
        }

        if (text === '.menu') {
            await sock.sendMessage(from, { text: '👋 Hola, soy tu bot.\n\nUsa:\n.mf + link de mediafire\n\nEjemplo:\n.mf https://www.mediafire.com/file/xxx' }, { quoted: m });
        }
    });

    sock.ev.on('connection.update', (update) => {
        const { connection } = update;
        if (connection === 'open') console.log('BOT CONECTADO');
    });
}
startBot();
